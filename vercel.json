{
  "framework": "nextjs",
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/cron/frequent",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "30 21 * * *"
    }
  ],
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ] && exit 1 || exit 0"
}
