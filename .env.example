# CodeKraft — environment variables (docs/12 §2.2). Copy to .env.local for local development.
# Core
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://admin.localhost:3000
ADMIN_HOST=admin.localhost:3000
# Database (local: pnpm db:local or docker compose up postgres)
DATABASE_URL=postgres://codekraft:codekraft@localhost:5432/codekraft
DATABASE_URL_UNPOOLED=postgres://codekraft:codekraft@localhost:5432/codekraft
# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_ENCRYPTION_KEY=
# Storage (Cloudflare R2 or local MinIO)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=codekraft-dev-public
R2_BUCKET_PRIVATE=codekraft-dev-private
R2_BUCKET_DOCUMENTS=codekraft-dev-documents
R2_BUCKET_BACKUPS=codekraft-dev-backups
NEXT_PUBLIC_MEDIA_BASE_URL=
# Email
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=CodeKraft <hello@localhost>
EMAIL_REPLY_TO=
EMAIL_ALLOWLIST=
EMAIL_TRANSPORT=log
# AI
ANTHROPIC_API_KEY=
# Forms
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Analytics
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Observability
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Jobs
CRON_SECRET=
RUN_SCHEDULER=false
FX_API_URL=https://open.er-api.com/v6/latest
# Feature flags (unset = DB value wins)
FEATURE_PHONE_OTP=
FEATURE_WHATSAPP_CHANNEL=
FEATURE_THEME_LIGHT_EDITORIAL=
FEATURE_PROVIDER_RAZORPAY=
FEATURE_PROVIDER_STRIPE=
FEATURE_PROVIDER_PAYPAL=
FEATURE_AUTOMATED_PROVISIONING=
FEATURE_THREE_HERO=
FEATURE_BUNDLES=
FEATURE_VENDOR_MARKETPLACE=
# CI-only
BACKUP_ENCRYPTION_KEY=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_PROJECT_ID_STAGING=
NEON_API_KEY=
NEON_PROJECT_ID=
LHCI_GITHUB_APP_TOKEN=
