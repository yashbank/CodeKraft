{
  "name": "codekraft",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cpu-features",
      "protobufjs",
      "ssh2",
      "esbuild",
      "embedded-postgres",
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/darwin-x64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/linux-arm64",
      "sharp",
      "argon2",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lhci": "lhci autorun",
    "db:local": "tsx scripts/db-local.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:anonymise": "tsx scripts/db-anonymise.ts",
    "db:studio": "drizzle-kit studio",
    "size": "tsx scripts/size-check.ts && size-limit"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^11.0.0",
    "argon2": "0.45.1",
    "better-auth": "1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^1.47.0",
    "next": "15.5.26",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.28.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.0",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "15.5.26",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "^14.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/parser": "8.70.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "^18.0.3",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "fast-check": "4.10.2",
    "globals": "^17.12.0",
    "jsdom": "30.1.1",
    "pino-pretty": "^13.1.3",
    "prettier": "3.9.9",
    "react-email": "^6.11.0",
    "size-limit": "^14.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11"
  }
}
